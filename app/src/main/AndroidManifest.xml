<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- BIND_ACCESSIBILITY_SERVICE is declared on the AccessibilityService below. -->

    <queries>
        <package android:name="com.grofers.customerapp" />
        <package android:name="in.swiggy.android" />
        <package android:name="in.swiggy.android.instamart" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beta">

        <!-- InputBroadcastReceiver removed - not available in current version -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="false"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="beta"
                    android:host="swiggy"
                    android:path="/oauth" />
            </intent-filter>
        </activity>

        <!-- AutomatedActionTestActivity removed - not available in current version -->

        <service
            android:name=".MyAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection">
            <meta-data android:name="android.service.foreground"
            android:value="true"/>
        </service>

        <receiver
            android:name=".AutomationInstructionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="live.betaapp.android.SUBMIT_AUTOMATION_INSTRUCTION" />
                <action android:name="live.betaapp.android.SEED_PREFERENCE" />
                <action android:name="live.betaapp.android.CLEAR_PREFERENCES" />
            </intent-filter>
        </receiver>

        <!-- OverlayInputService removed - not available in current version -->

        <!-- ButtonHighlightService removed - not available in current version -->

        <!-- ButtonAccessibilityService removed - not available in current version -->

        <!-- AutomatedActionService removed - not available in current version -->
    </application>

</manifest>
