<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beta_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/beta_btn_primary"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="β"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/app_name"
                android:textColor="@color/beta_text_primary"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/analyticsSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/analytics_settings"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@color/beta_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/mainTitle"
            style="@style/Beta.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/main_title" />

        <TextView
            android:id="@+id/mainSubtitle"
            style="@style/Beta.BodySoft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_subtitle"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text_agent_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/beta_pill_sage"
            android:contentDescription="@string/swiggy_connection_status"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/swiggy_connection_status"
            android:textColor="@color/beta_success"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mainPrimaryNote"
            style="@style/Beta.BodySoft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/swiggy_primary_note_disconnected"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/orderComposerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/beta_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                style="@style/Beta.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:labelFor="@id/orderCommandInput"
                android:text="@string/order_input_label" />

            <EditText
                android:id="@+id/orderCommandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/beta_input_field"
                android:gravity="top|start"
                android:hint="@string/order_input_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="72dp"
                android:padding="16dp"
                android:textColor="@color/beta_text_primary"
                android:textColorHint="@color/beta_text_secondary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/orderVoiceInputButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/beta_btn_primary"
                    android:contentDescription="@string/order_voice_start"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic" />

                <Button
                    android:id="@+id/orderSubmitButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/beta_btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="64dp"
                    android:stateListAnimator="@null"
                    android:text="@string/order_submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="19sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/orderInputStatus"
                style="@style/Beta.BodySoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/order_input_help"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/swiggySessionWarning"
                style="@style/Beta.BodySoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/swiggy_keep_closed_warning"
                android:textSize="16sp" />
            <Button
                android:id="@+id/swiggyCheckoutAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/swiggy_checkout_action"
                android:textSize="19sp"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/swiggyConnectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/beta_card_soft"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Beta.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/swiggy_connection_heading" />

            <TextView
                android:id="@+id/swiggyConnectionStatus"
                style="@style/Beta.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/swiggy_connection_status"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/swiggyConnectionDetail"
                style="@style/Beta.BodySoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/swiggy_connection_detail"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/swiggySelectedAddress"
                style="@style/Beta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityHeading="true"
                android:text="@string/swiggy_selected_address_placeholder"
                android:textSize="17sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swiggyChangeAddressAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/beta_btn_secondary"
                android:contentDescription="@string/swiggy_change_address"
                android:fontFamily="sans-serif-medium"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:text="@string/swiggy_change_address"
                android:textAllCaps="false"
                android:textColor="@color/beta_text_primary"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swiggyConnectionAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/beta_btn_primary"
                android:contentDescription="@string/swiggy_connection_action"
                android:fontFamily="sans-serif-medium"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:text="@string/swiggy_connection_action"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/beta_card_soft"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/beta_step_done"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Beta.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reassurance_heading"
                    android:textColor="@color/beta_success"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Beta.BodySoft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reassurance_body"
                    android:textColor="@color/beta_success"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
