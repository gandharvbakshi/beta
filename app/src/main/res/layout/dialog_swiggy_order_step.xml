<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swiggyStepRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beta_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/beta_btn_primary"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="β"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/beta_text_primary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/swiggyStepClose"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/beta_btn_secondary"
            android:fontFamily="sans-serif-medium"
            android:minWidth="96dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="@string/swiggy_step_stop"
            android:textAllCaps="false"
            android:textColor="@color/beta_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/swiggyStepScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/swiggyStepEyebrow"
                style="@style/Beta.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/swiggyStepTitle"
                style="@style/Beta.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/swiggyStepMessage"
                style="@style/Beta.BodySoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/swiggyStepItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/swiggyStepSafetyNote"
                style="@style/Beta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/beta_card_soft"
                android:padding="16dp"
                android:textColor="@color/beta_success"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swiggyStepPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/beta_btn_primary"
                android:fontFamily="sans-serif-medium"
                android:minHeight="64dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swiggyStepSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/beta_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/beta_text_primary"
                android:textSize="17sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swiggyStepTertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/beta_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/swiggyStepCaption"
                style="@style/Beta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/beta_card"
                android:padding="14dp"
                android:textColor="@color/beta_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
