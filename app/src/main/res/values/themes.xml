<resources xmlns:tools="http://schemas.android.com/tools">
<!-- Base application theme. -->
<style name="Base.Theme.Beta" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <!-- Customize your dark theme here. -->
    <item name="colorPrimary">@color/beta_primary</item>
    <item name="colorPrimaryVariant">@color/beta_primary_pressed</item>
    <item name="colorSecondary">@color/beta_secondary</item>
    <item name="colorSecondaryVariant">@color/beta_line</item>
    <item name="colorOnPrimary">@color/white</item>
    <item name="colorOnSecondary">@color/beta_text_primary</item>
    <item name="android:windowBackground">@color/beta_background</item>
    <item name="android:windowSplashScreenBackground">@color/beta_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="android:statusBarColor">@color/beta_background</item>
    <item name="android:navigationBarColor">@color/beta_background</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
</style>

<style name="Theme.Beta" parent="Base.Theme.Beta" />
</resources>
